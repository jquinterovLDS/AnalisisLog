MCAISSON) AS GCF_NUMCAISSON, '-' AS GCF_PIECES, '' AS GCF_NUMENVELOPPE, MAX(CTRLCAISMT.GJM_PIECECOF) AS PIECECOF, MAX(CTRLCAISMT.GJM_BILLETCOF) AS BILLETCOF, MAX(CTRLCAISMT.GJM_NUMENV) AS NUMENV, MAX(CTRLCAISMT.GJM_NUMENVPIECE) AS NUMENVPIECE, MAX(CTRLCAISMT.GJM_COTATION) AS COTATION, MAX(MODEPAIE.MP_TYPEMODEPAIE) AS MODEPAIE, MAX(CASE WHEN MODEPAIECOMPL.MPC_ETABLISSEMENT = '756' THEN MODEPAIECOMPL.MPC_PIECEBILLETCOF ELSE MODEPAIE.MP_PIECEBILLETCOF END) AS PIECEBILLET FROM PIEDECHE LEFT JOIN PIECE ON PIECE.GP_NATUREPIECEG = PIEDECHE.GPE_NATUREPIECEG AND PIECE.GP_SOUCHE = PIEDECHE.GPE_SOUCHE AND PIECE.GP_NUMERO = PIEDECHE.GPE_NUMERO AND PIECE.GP_INDICEG = PIEDECHE.GPE_INDICEG LEFT JOIN LIGNESCOFFRE ON LIGNESCOFFRE.GCF_NATUREPIECEG = PIEDECHE.GPE_NATUREPIECEG AND LIGNESCOFFRE.GCF_SOUCHE = PIEDECHE.GPE_SOUCHE AND LIGNESCOFFRE.GCF_NUMERO = PIEDECHE.GPE_NUMERO AND LIGNESCOFFRE.GCF_INDICEG = PIEDECHE.GPE_INDICEG AND PIEDECHE.GPE_NUMECHE = LIGNESCOFFRE.GCF_NUMECHE LEFT JOIN MODEPAIE ON MODEPAIE.MP_MODEPAIE = PIEDECHE.GPE_MODEPAIE LEFT JOIN CTRLCAISMT ON CTRLCAISMT.GJM_CAISSE = PIEDECHE.GPE_CAISSE AND CTRLCAISMT.GJM_NUMZCAISSE = PIEDECHE.GPE_NUMZCAISSE AND CTRLCAISMT.GJM_MODEPAIE = PIEDECHE.GPE_MODEPAIE LEFT JOIN MODEPAIECOMPL ON MODEPAIECOMPL.MPC_MODEPAIE = PIEDECHE.GPE_MODEPAIE AND MODEPAIECOMPL.MPC_ETABLISSEMENT = '756' WHERE PIEDECHE.GPE_NATUREPIECEG = 'FFO' AND PIEDECHE.GPE_CAISSE = '756001' AND PIEDECHE.GPE_NUMZCAISSE >= 29 AND PIEDECHE.GPE_NUMZCAISSE <= 29 AND PIEDECHE.GPE_DATEPIECE >= '20250625 00:00:00' AND PIEDECHE.GPE_DATEPIECE <= '20250625 00:00:00' AND PIEDECHE.GPE_ETABLISSEMENT = '756' AND (LIGNESCOFFRE.GCF_NATUREPIECEG IS NULL) AND PIEDECHE.GPE_MONTANTENCAIS <> 0 AND ISNULL(MODEPAIECOMPL.MPC_REMISENBANQUE , MODEPAIE.MP_REMISENBANQUE) = 'X' AND PIECE.GP_TICKETANNULE = '-' AND NOT EXISTS(SELECT 1 FROM LIGNE WHERE LIGNE.GL_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND LIGNE.GL_SOUCHE = PIECE.GP_SOUCHE AND LIGNE.GL_NUMERO = PIECE.GP_NUMERO AND LIGNE.GL_INDICEG = PIECE.GP_INDICEG AND LIGNE.GL_TYPEARTICLE = 'FI' AND LIGNE.GL_CODEARTICLE = 'PRE' ) AND PIEDECHE.GPE_ABSENTCTRLCAIS = '-' GROUP BY PIEDECHE.GPE_NATUREPIECEG, PIEDECHE.GPE_SOUCHE, MODEPAIE.MP_TYPEMODEPAIE, CASE WHEN MODEPAIE.MP_TYPEMODEPAIE = '001' THEN 0 ELSE PIEDECHE.GPE_NUMECHE END, CASE WHEN MODEPAIE.MP_TYPEMODEPAIE = '001' THEN MODEPAIE.MP_MODEPAIE ELSE MODEPAIE.MP_MODEPAIE + CONVERT(VARCHAR, PIEDECHE.GPE_NUMERO) + CONVERT(VARCHAR, PIEDECHE.GPE_INDICEG) + CONVERT(VARCHAR, PIEDECHE.GPE_NUMECHE) END, PIEDECHE.GPE_ETABLISSEMENT HAVING CASE WHEN MODEPAIE.MP_TYPEMODEPAIE = '001' THEN MAX(CTRLCAISMT.GJM_TOTALDEV - CTRLCAISMT.GJM_FDCAISSEDEV) ELSE SUM(PIEDECHE.GPE_MONTANTENCAIS) END <> 0
