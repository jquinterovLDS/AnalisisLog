06/26/2025 00:49:28.518 | 205124809625051 | 152 | STUDIOF_PRD | INF | STUDIOF_PRD\POS105C2 | LegacyQueries | ApplicationFlow | [PGI] /* StandardForm:TFTicketFO */  SELECT GPE_MODEPAIE, SUM(GPE_MONTANTENCAIS) SUM_GPE_MONTANTENCAIS , MP_MONTANTMAXCAIS , SUM(GCF_MONTANTECHE) SUM_RECOGIDA FROM PIEDECHE INNER JOIN MODEPAIE ON GPE_MODEPAIE=MP_MODEPAIE INNER JOIN PIECE ON GPE_SOUCHE=GP_SOUCHE AND GPE_NATUREPIECEG=GP_NATUREPIECEG AND GPE_NUMERO=GP_NUMERO LEFT JOIN LIGNESCOFFRE ON GPE_NUMZCAISSE = GCF_NUMZCAISSE AND GPE_CAISSE = GCF_CAISSE AND GPE_MODEPAIE = GCF_MODEPAIE WHERE GPE_CAISSE="105002" AND GPE_SOUCHE="105" AND GPE_NUMZCAISSE=30 AND GPE_NATUREPIECEG="FFO" AND GP_ETATCOMPTA<>"EXC"  AND GPE_MODEPAIE="E" and MP_MONTANTMAXCAIS <> 0  GROUP BY GPE_MODEPAIE, MP_MONTANTMAXCAIS HAVING ISNULL(SUM(GPE_MONTANTENCAIS),0) - ISNULL(SUM(GCF_MONTANTECHE),0)>= MP_MONTANTMAXCAIS 
06/26/2025 00:49:28.518 | 205124809654228 | 152 | STUDIOF_PRD | INF | STUDIOF_PRD\POS105C2 | Cegid.Framework.Data | SqlService | [NATIVE] /* StandardForm:TFTicketFO */ SELECT TOP (1) SOURCE.GPE_MODEPAIE, SOURCE.SUM_GPE_MONTANTENCAIS, SOURCE.MP_MONTANTMAXCAIS, SOURCE.SUM_RECOGIDA FROM (SELECT PIEDECHE.GPE_MODEPAIE, SUM(PIEDECHE.GPE_MONTANTENCAIS) AS SUM_GPE_MONTANTENCAIS, MODEPAIE.MP_MONTANTMAXCAIS, SUM(LIGNESCOFFRE.GCF_MONTANTECHE) AS SUM_RECOGIDA FROM PIEDECHE JOIN MODEPAIE ON PIEDECHE.GPE_MODEPAIE = MODEPAIE.MP_MODEPAIE JOIN PIECE ON PIEDECHE.GPE_SOUCHE = PIECE.GP_SOUCHE AND PIEDECHE.GPE_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND PIEDECHE.GPE_NUMERO = PIECE.GP_NUMERO LEFT JOIN LIGNESCOFFRE ON PIEDECHE.GPE_NUMZCAISSE = LIGNESCOFFRE.GCF_NUMZCAISSE AND PIEDECHE.GPE_CAISSE = LIGNESCOFFRE.GCF_CAISSE AND PIEDECHE.GPE_MODEPAIE = LIGNESCOFFRE.GCF_MODEPAIE WHERE PIEDECHE.GPE_CAISSE = '105002' AND PIEDECHE.GPE_SOUCHE = '105' AND PIEDECHE.GPE_NUMZCAISSE = 30 AND PIEDECHE.GPE_NATUREPIECEG = 'FFO' AND PIECE.GP_ETATCOMPTA <> 'EXC' AND PIEDECHE.GPE_MODEPAIE = 'E' AND MODEPAIE.MP_MONTANTMAXCAIS <> 0 GROUP BY PIEDECHE.GPE_MODEPAIE, MODEPAIE.MP_MONTANTMAXCAIS HAVING ISNULL(SUM(PIEDECHE.GPE_MONTANTENCAIS) , 0) - ISNULL(SUM(LIGNESCOFFRE.GCF_MONTANTECHE) , 0) >= MODEPAIE.MP_MONTANTMAXCAIS) AS SOURCE 
