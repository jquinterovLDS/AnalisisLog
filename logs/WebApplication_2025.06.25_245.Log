06/26/2025 00:50:46.514 | 205125589658745 | 81 | STUDIOF_PRD | INF | STUDIOF_PRD\pos554c1 | Cegid.Framework.Data | SqlService | [NATIVE] /* StandardForm:TFTicketFO */ SELECT TOP (1) SOURCE.GPE_MODEPAIE, SOURCE.SUM_GPE_MONTANTENCAIS, SOURCE.MP_MONTANTMAXCAIS, SOURCE.SUM_RECOGIDA FROM (SELECT PIEDECHE.GPE_MODEPAIE, SUM(PIEDECHE.GPE_MONTANTENCAIS) AS SUM_GPE_MONTANTENCAIS, MODEPAIE.MP_MONTANTMAXCAIS, SUM(LIGNESCOFFRE.GCF_MONTANTECHE) AS SUM_RECOGIDA FROM PIEDECHE JOIN MODEPAIE ON PIEDECHE.GPE_MODEPAIE = MODEPAIE.MP_MODEPAIE JOIN PIECE ON PIEDECHE.GPE_SOUCHE = PIECE.GP_SOUCHE AND PIEDECHE.GPE_NATUREPIECEG = PIECE.GP_NATUREPIECEG AND PIEDECHE.GPE_NUMERO = PIECE.GP_NUMERO LEFT JOIN LIGNESCOFFRE ON PIEDECHE.GPE_NUMZCAISSE = LIGNESCOFFRE.GCF_NUMZCAISSE AND PIEDECHE.GPE_CAISSE = LIGNESCOFFRE.GCF_CAISSE AND PIEDECHE.GPE_MODEPAIE = LIGNESCOFFRE.GCF_MODEPAIE WHERE PIEDECHE.GPE_CAISSE = '554001' AND PIEDECHE.GPE_SOUCHE = '554' AND PIEDECHE.GPE_NUMZCAISSE = 15 AND PIEDECHE.GPE_NATUREPIECEG = 'FFO' AND PIECE.GP_ETATCOMPTA <> 'EXC' AND PIEDECHE.GPE_MODEPAIE = 'E' AND MODEPAIE.MP_MONTANTMAXCAIS <> 0 GROUP BY PIEDECHE.GPE_MODEPAIE, MODEPAIE.MP_MONTANTMAXCAIS HAVING ISNULL(SUM(PIEDECHE.GPE_MONTANTENCAIS) , 0) - ISNULL(SUM(LIGNESCOFFRE.GCF_MONTANTECHE) , 0) >= MODEPAIE.MP_MONTANTMAXCAIS) AS SOURCE 
